# =============================================================================
# Rupiyah — local secrets template
# =============================================================================
# Copy this file to `.env` for your own notes, or use `keystore.properties`
# for release signing (preferred for Gradle).
#
# NEVER commit a real `.env` or `keystore.properties` file.
# Runtime API keys (LLM, Gmail, Sheets) are entered in the app UI and stored
# in EncryptedSharedPreferences — they are not read from this file.
# =============================================================================

# --- Release signing (optional; same values as keystore.properties) ---
# Paths are relative to the project root when passed as -PRELEASE_STORE_FILE.
RELEASE_STORE_FILE=keystore/your-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# --- Optional developer notes (not loaded by the app) ---
# GOOGLE_CLOUD_PROJECT=
# DEBUG_SHA256=
