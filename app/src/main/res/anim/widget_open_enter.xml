<?xml version="1.0" encoding="utf-8"?>
<!-- App rising in from the home-screen widget. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="280"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <scale
        android:fromXScale="0.92"
        android:toXScale="1"
        android:fromYScale="0.92"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="340"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <translate
        android:fromYDelta="6%p"
        android:toYDelta="0"
        android:duration="340"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
