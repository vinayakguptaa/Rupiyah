# =============================================================================
# Rupiyah — Git ignore rules
# =============================================================================

# --- Android / Gradle ---
.gradle/
build/
**/build/
local.properties
*.iml
.idea/
.cxx/
captures/
.externalNativeBuild/
.navigation/
outputs/

# --- Signing secrets (never commit) ---
keystore/*.jks
keystore/*.keystore
keystore.properties
*.jks
*.keystore
*.p12
*.pem

# --- Environment / local secrets ---
.env
.env.*
!.env.example
!.env.example.*
secrets.properties
google-services.json

# --- OS ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Kotlin / JVM / tooling ---
.kotlin/
*.hprof
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# --- Build outputs ---
apk/
*.apk
*.aab
*.ap_
*.dex
*.so
bin/
gen/
out/

# --- Logs & temp ---
*.log
*.tmp
*.swp
*~
*.bak

# --- Editors / misc ---
*.sublime-workspace
*.code-workspace
.vscode/
!.vscode/extensions.json
.fleet/

# --- Grok / session artifacts ---
.grok_*/
.grok*

# --- Local trash (moved unused files; keep off git) ---
trashed/
_trashed/

# --- Optional local notes ---
*.local.md
